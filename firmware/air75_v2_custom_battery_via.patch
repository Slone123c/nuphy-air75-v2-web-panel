+
+#ifdef VIA_ENABLE
+enum air75_via_custom_value {
+    ID_SIDE_MODE = 1,
+    ID_SIDE_LIGHT,
+    ID_SIDE_SPEED,
+    ID_SIDE_RGB,
+    ID_SIDE_COLOUR,
+    ID_SLEEP_ENABLE,
+    ID_BAT_HOLD,
+    ID_BAT_DEMO,
+    ID_DEV_STATUS,
+    ID_SIDE_CUSTOM_LEFT,
+    ID_SIDE_CUSTOM_RIGHT,
+    ID_SIDE_LEDS_LEFT,
+    ID_SIDE_LEDS_RIGHT,
+};
+
+static void air75_via_copy_side_leds(uint8_t offset, uint8_t *dest) {
+    for (uint8_t i = 0; i < 6; i++) {
+        dest[i * 3 + 0] = side_leds[offset + i].r;
+        dest[i * 3 + 1] = side_leds[offset + i].g;
+        dest[i * 3 + 2] = side_leds[offset + i].b;
+    }
+}
+
+static void air75_via_get_value(uint8_t *command_id, uint8_t value_id, uint8_t *value_data) {
+    switch (value_id) {
+        case ID_SIDE_MODE:
+            value_data[0] = side_mode;
+            break;
+        case ID_SIDE_LIGHT:
+            value_data[0] = side_light;
+            break;
+        case ID_SIDE_SPEED:
+            value_data[0] = side_speed;
+            break;
+        case ID_SIDE_RGB:
+            value_data[0] = side_rgb;
+            break;
+        case ID_SIDE_COLOUR:
+            value_data[0] = side_colour;
+            break;
+        case ID_SLEEP_ENABLE:
+            value_data[0] = user_config.sleep_enable ? 1 : 0;
+            break;
+        case ID_BAT_HOLD:
+            value_data[0] = f_bat_hold ? 1 : 0;
+            break;
+        case ID_BAT_DEMO:
+            value_data[0] = f_bat_demo ? 1 : 0;
+            break;
+        case ID_DEV_STATUS:
+            value_data[0] = dev_info.rf_baterry;
+            value_data[1] = dev_info.rf_charge;
+            value_data[2] = dev_info.link_mode;
+            value_data[3] = dev_info.sys_sw_state;
+            value_data[4] = dev_info.rf_state;
+            value_data[5] = f_bat_demo ? 1 : 0;
+            break;
+        case ID_SIDE_CUSTOM_LEFT:
+            value_data[0] = side_custom_left_enable ? 1 : 0;
+            value_data[1] = side_custom_left_r;
+            value_data[2] = side_custom_left_g;
+            value_data[3] = side_custom_left_b;
+            break;
+        case ID_SIDE_CUSTOM_RIGHT:
+            value_data[0] = side_custom_right_enable ? 1 : 0;
+            value_data[1] = side_custom_right_r;
+            value_data[2] = side_custom_right_g;
+            value_data[3] = side_custom_right_b;
+            break;
+        case ID_SIDE_LEDS_LEFT:
+            air75_via_copy_side_leds(0, value_data);
+            break;
+        case ID_SIDE_LEDS_RIGHT:
+            air75_via_copy_side_leds(6, value_data);
+            break;
+        default:
+            *command_id = id_unhandled;
+            break;
+    }
+}
+
+static void air75_via_set_value(uint8_t *command_id, uint8_t value_id, const uint8_t *value_data) {
+    switch (value_id) {
+        case ID_SIDE_MODE:
+            side_mode       = (value_data[0] <= 4) ? value_data[0] : 4;
+            side_play_point = 0;
+            break;
+        case ID_SIDE_LIGHT:
+            side_light = (value_data[0] <= 5) ? value_data[0] : 5;
+            break;
+        case ID_SIDE_SPEED:
+            side_speed = (value_data[0] <= 4) ? value_data[0] : 4;
+            break;
+        case ID_SIDE_RGB:
+            side_rgb = value_data[0] ? 1 : 0;
+            break;
+        case ID_SIDE_COLOUR:
+            side_colour = (value_data[0] <= 8) ? value_data[0] : 8;
+            break;
+        case ID_SLEEP_ENABLE:
+            user_config.sleep_enable = value_data[0] ? 1 : 0;
+            break;
+        case ID_BAT_HOLD:
+            f_bat_hold = value_data[0] ? true : false;
+            break;
+        case ID_BAT_DEMO:
+            f_bat_demo = value_data[0] ? true : false;
+            break;
+        case ID_SIDE_CUSTOM_LEFT:
+            side_custom_left_enable = value_data[0] ? true : false;
+            side_custom_left_r      = value_data[1];
+            side_custom_left_g      = value_data[2];
+            side_custom_left_b      = value_data[3];
+            break;
+        case ID_SIDE_CUSTOM_RIGHT:
+            side_custom_right_enable = value_data[0] ? true : false;
+            side_custom_right_r      = value_data[1];
+            side_custom_right_g      = value_data[2];
+            side_custom_right_b      = value_data[3];
+            break;
+        default:
+            *command_id = id_unhandled;
+            break;
+    }
+}
+
+static void air75_via_save(void) {
+    user_config.ee_side_mode   = side_mode;
+    user_config.ee_side_light  = side_light;
+    user_config.ee_side_speed  = side_speed;
+    user_config.ee_side_rgb    = side_rgb;
+    user_config.ee_side_colour = side_colour;
+    eeconfig_update_user_datablock(&user_config);
+}
+
+void via_custom_value_command_kb(uint8_t *data, uint8_t length) {
+    (void)length;
+    uint8_t *command_id = &(data[0]);
+    uint8_t  channel_id = data[1];
+    uint8_t  value_id   = data[2];
+    uint8_t *value_data = &(data[3]);
+
+    if (channel_id != id_custom_channel) {
+        *command_id = id_unhandled;
+        return;
+    }
+
+    switch (*command_id) {
+        case id_custom_get_value:
+            air75_via_get_value(command_id, value_id, value_data);
+            break;
+        case id_custom_set_value:
+            air75_via_set_value(command_id, value_id, value_data);
+            break;
+        case id_custom_save:
+            air75_via_save();
+            break;
+        default:
+            *command_id = id_unhandled;
+            break;
+    }
+}
+#endif
